{
  "name": "@yuzhe/dsh-adapter",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "npm run build --workspace=@yuzhe/contracts",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "npm run build --workspace=@yuzhe/contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@yuzhe/contracts": "0.1.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "@types/node": "^22.10.2"
  }
}
